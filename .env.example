SCRAPER_SCHEDULE_ENABLED=false
SIMILARITY_DEVICE=cpu
SIMILARITY_MIN_RESULTS=10
SCRAPER_MAX_RESULTS=25

# Backend-only AI key. Never expose this as a VITE_* frontend variable.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Frontend API base URL. In local development this usually points to FastAPI.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
