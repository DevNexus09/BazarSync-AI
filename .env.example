SCRAPER_SCHEDULE_ENABLED=false
RECOMMENDATION_JOBS_ENABLED=false
RECOMMENDATION_VALIDATION_ENABLED=false
RECOMMENDATION_EXPLANATION_ENABLED=false
RECOMMENDATION_EXPLANATION_GROQ_ENABLED=false
RECOMMENDATION_EXPLANATION_MODEL=openai/gpt-oss-20b
RECOMMENDATION_EXPLANATION_TEMPERATURE=0.1
RECOMMENDATION_EXPLANATION_TIMEOUT_SECONDS=4
RECOMMENDATION_EXPLANATION_MAX_RETRIES=0
RECOMMENDATION_DASHBOARD_EVIDENCE_ENABLED=false
RECOMMENDATION_ORCHESTRATION_ENABLED=false
RECOMMENDATION_ORCHESTRATION_SHADOW_ENABLED=false
HISTORICAL_DATASET_EXPORT_ENABLED=false
RECOMMENDATION_ACTION_EVALUATION_ENABLED=false
FORECAST_ASSISTED_PRICING_ENABLED=false
FORECAST_AWARE_REORDER_ENABLED=false
EVIDENCE_DRIVEN_RECOVERY_ENABLED=false
REORDER_TARGET_SERVICE_LEVEL=0.90
# Optional Task 14 runtime for approved baseline forecasts
FORECAST_ML_MODE=disabled
# FORECAST_ARTIFACT_ROOT=/models
# FORECAST_REGISTRY_SHA256=
# FORECAST_INFERENCE_PYTHON=/opt/forecast/bin/python
RECOMMENDATION_ACTION_MIN_SCORE=0.50
RECOMMENDATION_ACTION_PROFIT_REFERENCE_BDT=1000
RECOMMENDATION_ACTION_MAX_ADVERSE_RISK=0.60
RECOMMENDATION_EVIDENCE_ENABLED=false
RECOMMENDATION_BUSINESS_SIGNALS_ENABLED=false
RECOMMENDATION_INVENTORY_MAX_AGE_HOURS=48
RECOMMENDATION_PRICE_MAX_AGE_HOURS=24
RECOMMENDATION_STOCK_MAX_AGE_HOURS=6
DARAZ_SCRAPING_AUTHORIZED=false
SIMILARITY_DEVICE=cpu
SIMILARITY_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
SIMILARITY_BATCH_SIZE=32
SIMILARITY_THRESHOLD=0.65
SIMILARITY_VERIFICATION_FLOOR=0.50
SIMILARITY_POSSIBLE_THRESHOLD=0.50
SIMILARITY_VERY_STRONG_THRESHOLD=0.88
SIMILARITY_MIN_TITLE_EVIDENCE=0.55
SIMILARITY_DIMENSIONS_TOLERANCE=0.03
SCRAPER_MAX_RESULTS=25
# Optional JSON map of positive completeness weights. Unlisted fields do not contribute.
# SCRAPER_EXTRACTION_WEIGHTS={"current_price":3,"seller_name":2,"stock_status":2}
SCRAPER_DETAIL_CONCURRENCY=3
SCRAPER_HTTPX_ENABLED=true
SCRAPER_HTTPX_CONNECT_TIMEOUT=10
SCRAPER_HTTPX_READ_TIMEOUT=30
SCRAPER_HTTPX_WRITE_TIMEOUT=10
SCRAPER_HTTPX_POOL_TIMEOUT=10
SCRAPER_HTTPX_TOTAL_TIMEOUT=45
SCRAPER_HTTPX_MAX_CONNECTIONS=10
SCRAPER_HTTPX_MAX_KEEPALIVE_CONNECTIONS=5
# Set these within Daraz's authorized limits. Use the same values on all workers.
SCRAPER_DARAZ_MIN_INTERVAL_SECONDS=0.5
SCRAPER_DARAZ_MAX_IN_FLIGHT=3
SCRAPER_DARAZ_SLOT_WAIT_SECONDS=20

# Backend-only AI key. Never expose this as a VITE_* frontend variable.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Business Copilot runtime limits. GROQ_COPILOT_MODEL falls back to GROQ_MODEL.
GROQ_COPILOT_MODEL=
COPILOT_GROQ_TIMEOUT_SECONDS=20
COPILOT_OVERALL_TIMEOUT_SECONDS=45
COPILOT_MAX_TOOL_CALLS=10
COPILOT_MAX_ITERATIONS=3
COPILOT_PLANNING_MESSAGE_LIMIT=12
COPILOT_PLANNING_CHARACTER_LIMIT=6000
# Bangla, English and Banglish detection, normalisation and same-language replies. Default off.
COPILOT_MULTILINGUAL_ENABLED=false
# Provider-neutral answer routing. Off = the legacy single Groq call.
# Routes are comma-separated "provider:model" entries tried in order within one overall
# timeout (COPILOT_GROQ_TIMEOUT_SECONDS). A bare "groq" uses GROQ_COPILOT_MODEL/GROQ_MODEL;
# a bare "anthropic" uses claude-opus-5-5. Per-language lists are tried before the default list.
COPILOT_LLM_ROUTER_ENABLED=false
COPILOT_LLM_ANSWER_ROUTES=groq
COPILOT_LLM_ANSWER_ROUTES_EN=
COPILOT_LLM_ANSWER_ROUTES_BN=
COPILOT_LLM_ANSWER_ROUTES_BANGLISH=
# Backend-only. Needed only when a route uses "anthropic"; leave commented out otherwise
# (an empty value would shadow other Anthropic credentials). Never expose as a VITE_* variable.
# ANTHROPIC_API_KEY=
COPILOT_ANTHROPIC_EFFORT=low
COPILOT_ANTHROPIC_MAX_TOKENS=16000
# Prompt size caps (characters) for tool facts sent to the answer model.
COPILOT_PROMPT_TOOL_CHARS=12000
COPILOT_PROMPT_TOTAL_CHARS=48000
# Chat quality switches, all default off.
COPILOT_CONVERSATION_MEMORY_ENABLED=false
COPILOT_CONVERSATION_MEMORY_TURNS=4
COPILOT_ANSWER_REPAIR_ENABLED=false
COPILOT_FOLLOW_UPS_ENABLED=false
COPILOT_PARALLEL_TOOLS_ENABLED=false
COPILOT_TOOL_CONCURRENCY=4
COPILOT_LLM_PLANNER_FALLBACK_ENABLED=false
COPILOT_STREAMING_ENABLED=false
# Refuse prompt-injection/override requests, clarify unresolved references, label recommendation questions.
COPILOT_STRICT_SAFETY_PLANNING_ENABLED=false
# Questions per seller per minute; 0 disables the limit.
COPILOT_ASK_RATE_LIMIT_PER_MINUTE=0

# Password reset is backend-only. Set EMAIL_PROVIDER=smtp outside local development.
PASSWORD_RESET_ENABLED=true
PASSWORD_RESET_CODE_LENGTH=6
PASSWORD_RESET_CODE_TTL_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_MAX_REQUESTS_PER_HOUR=5
PASSWORD_RESET_MAX_REQUESTS_PER_IP=20
PASSWORD_RESET_AUTH_TTL_MINUTES=15
PASSWORD_RESET_REVOKE_SESSIONS=true
PASSWORD_RESET_CODE_SECRET=replace_with_a_long_random_backend_secret
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10
PASSWORD_RESET_EMAIL_RETRY_ATTEMPTS=2

# Phase 12 RAG memory embeddings. BGE-M3 is preferred when local resources allow it.
RAG_ENABLED=false
RAG_EMBEDDING_PROVIDER=local_bge
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_EMBEDDING_DEVICE=mps
RAG_EMBEDDING_BATCH_SIZE=4
RAG_EMBEDDING_NORMALIZE=true
RAG_EMBEDDING_VERSION=v1
RAG_CHUNKING_VERSION=v1
RAG_MAX_CHUNK_CHARS=1200
RAG_CHUNK_OVERLAP_CHARS=120
RAG_RETRIEVAL_TOP_K=8
RAG_MIN_SIMILARITY=0.25
RAG_PROMPT_VERSION=v1
RAG_GROQ_MODEL=openai/gpt-oss-120b
# Use cosine distance (matches the HNSW vector_cosine_ops index) instead of legacy L2. Re-check RAG_MIN_SIMILARITY when enabling.
RAG_COSINE_DISTANCE_ENABLED=false
# Seller-scoped in-process cache of question embeddings; 0 disables it.
RAG_QUERY_EMBEDDING_CACHE_SIZE=0
RAG_UNEMBEDDED_CHUNK_BATCH_SIZE=100
RAG_MEMORY_SCHEDULE_ENABLED=false
RAG_MEMORY_DAILY_HOUR_UTC=3
RAG_MEMORY_DAILY_MINUTE_UTC=30
RAG_OUTBOX_BATCH_SIZE=100
RAG_OUTBOX_MAX_ATTEMPTS=5
RAG_OUTBOX_INITIAL_BACKOFF_SECONDS=60
RAG_OUTBOX_MAX_BACKOFF_SECONDS=3600
RAG_OUTBOX_PROCESSING_LEASE_SECONDS=900

# Frontend API base URL. In local development this usually points to FastAPI.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Daraz adaptive scheduling is opt-in. The six-hour and nightly Beat entries are retained.
SCRAPER_ADAPTIVE_ENABLED=false
# SCRAPER_REFRESH_POLICY={"normal_hours":6,"volatile_hours":3,"stable_hours":12,"failure_hours":12,"max_per_tick":25,"max_in_flight":50}
SCRAPER_METADATA_CACHE_TTL=21600
SCRAPER_DARAZ_BUDGET_PER_MINUTE=120
SCRAPER_DARAZ_CIRCUIT_FAILURES=5
SCRAPER_DARAZ_CIRCUIT_WINDOW_SECONDS=60
SCRAPER_DARAZ_CIRCUIT_COOLDOWN_SECONDS=120

# Optional seller-facing recommendation evidence sections.
VITE_RECOMMENDATION_DASHBOARD_V2=false
