FROM mcr.microsoft.com/playwright/python:v1.60.0-noble

WORKDIR /app

# install python deps first (important for caching)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# DO NOT run playwright install manually (IMPORTANT)
# base image already includes browsers correctly

COPY . .

ENV PYTHONUNBUFFERED=1
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
ENV PLAYWRIGHT_DISABLE_SANDBOX=1

CMD ["celery", "-A", "app.core.celery_app", "worker", "--loglevel=info", "--concurrency=2"]